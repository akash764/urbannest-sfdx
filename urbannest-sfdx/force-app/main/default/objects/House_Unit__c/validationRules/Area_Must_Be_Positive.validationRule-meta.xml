<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Area_Must_Be_Positive</fullName>
    <active>true</active>
    <description></description>
    <errorConditionFormula>AND(NOT(ISBLANK(Area_SqFt__c)), Area_SqFt__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Area_SqFt__c</errorDisplayField>
    <errorMessage>Area must be greater than zero.</errorMessage>
</ValidationRule>
